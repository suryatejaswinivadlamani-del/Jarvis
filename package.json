{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm --prefix ../server run start\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -n backend,renderer,desktop \"npm --prefix ../server run start\" \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175 && electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "test:voice": "node --test test/audio.test.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "J.A.R.V.I.S",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.cache/**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
